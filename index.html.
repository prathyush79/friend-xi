const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const ini=n=>(n||'?').split(/\s+/).map(w=>w[0]).slice(0,2).join('').toUpperCase();
const opts=(a,v)=>a.map(o=>`<option ${o===v?'selected':''}>${o}</option>`).join('');
let sb,user=null,role='viewer',D={league:null,players:[],teams:[],tp:[],matches:[],mp:[],ds:[],cd:[],stats:{P:{},res:{},sug:{}},profiles:[],rr:[],linkReqs:[]};
const isAdmin=()=>role==='admin',isMgr=()=>role==='admin'||role==='manager';

function toast(t,bad){const e=document.getElementById('toast');e.textContent=t;e.className=bad?'er':'';e.style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.display='none',bad?6000:3200)}
function modal(html){const m=document.createElement('div');m.className='mo';m.innerHTML=`<div class="sheet">${html}</div>`;m.onclick=e=>{if(e.target===m)m.remove()};document.body.appendChild(m);return m}
