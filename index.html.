const logo=t=>t.logo_url?`<img class="av" src="${esc(t.logo_url)}" alt="">`:`<div class="av" style="background:${esc(t.color)};color:#000;border:0">${esc(t.initials||ini(t.name))}</div>`;
const tabs=a=>`<div class="tabs"><a href="#/players" class="${a==='p'?'on':''}">Players</a><a href="#/teams" class="${a==='t'?'on':''}">Teams</a></div>`;

/* ---------- photos: pick, crop/reposition, upload ---------- */
function crop(file,aspect){return new Promise(res=>{const img=new Image();
 img.onerror=()=>{toast('Could not read that image',1);res(null)};
 img.onload=()=>{const W=480,H=Math.round(W/aspect);
  const m=modal(`<h3>Position photo</h3><canvas width="${W}" height="${H}" style="width:100%;touch-action:none;border-radius:12px;background:#000"></canvas><label>Zoom<input type="range" min="1" max="3" step="0.01" value="1"></label><div class="row"><button class="b2" id="cc">Cancel</button><button class="b" id="ok">Use photo</button></div>`);
  const cv=m.querySelector('canvas'),x=cv.getContext('2d'),base=Math.max(W/img.width,H/img.height);let z=1,ox=(W-img.width*base)/2,oy=(H-img.height*base)/2,d=null;
  const draw=()=>{const w=img.width*base*z,h=img.height*base*z;ox=Math.min(0,Math.max(W-w,ox));oy=Math.min(0,Math.max(H-h,oy));x.fillStyle='#000';x.fillRect(0,0,W,H);x.drawImage(img,ox,oy,w,h)};draw();
  cv.onpointerdown=e=>{d=[e.clientX,e.clientY];cv.setPointerCapture(e.pointerId)};
  cv.onpointermove=e=>{if(!d)return;const k=W/cv.getBoundingClientRect().width;ox+=(e.clientX-d[0])*k;oy+=(e.clientY-d[1])*k;d=[e.clientX,e.clientY];draw()};
  cv.onpointerup=()=>d=null;
  m.querySelector('input').oninput=e=>{const n=+e.target.value;ox=W/2-(W/2-ox)*n/z;oy=H/2-(H/2-oy)*n/z;z=n;draw()};
  m.querySelector('#cc').onclick=()=>{m.remove();res(null)};
  m.querySelector('#ok').onclick=()=>cv.toBlob(b=>{m.remove();res(b)},'image/jpeg',.85)};
 img.src=URL.createObjectURL(file)})}
function pick(aspect,cam){return new Promise(res=>{const i=document.createElement('input');i.type='file';i.accept='image/*';if(cam)i.setAttribute('capture','user');i.onchange=()=>i.files[0]?crop(i.files[0],aspect).then(res):res(null);i.click()})}
async function upload(blob,folder){const path=`${folder}/${crypto.randomUUID()}.jpg`;const {error}=await sb.storage.from('photos').upload(path,blob,{contentType:'image/jpeg'});if(error)throw error;return sb.storage.from('photos').getPublicUrl(path).data.publicUrl}
function photoUI(el,o){let blob=null,rm=false;
 const r=()=>{const src=blob?URL.createObjectURL(blob):(rm?'':o.url);
  el.innerHTML=`<div class="pv ${o.aspect>1?'wide':''}">${src?`<img src="${src}" alt="">`:`<span>${esc(o.ph)}</span>`}</div><div class="row"><button type="button" class="b" data-a="up">${src?'Replace':'Upload'} photo</button><button type="button" class="b2" data-a="cam">Camera</button>${src?'<button type="button" class="b2" data-a="rm">Remove</button>':''}</div>`};
 el.onclick=async e=>{const a=e.target.dataset.a;if(!a)return;if(a==='rm'){blob=null;rm=true}else{const b=await pick(o.aspect,a==='cam');if(b){blob=b;rm=false}}r()};r();
 return async folder=>blob?await upload(blob,folder):(rm?null:(o.url||null))}

/* ---------- data ---------- */
async function load(){const [l,p,t,tp,mt,mp]=await Promise.all([sb.from('league').select('*').maybeSingle(),sb.from('players').select('*').order('created_at'),sb.from('teams').select('*').order('created_at'),sb.from('team_players').select('*'),sb.from('matches').select('*').order('match_date'),sb.from('match_players').select('*')]);
 const e=l.error||p.error||t.error||tp.error||mt.error||mp.error;if(e)return toast('Could not load data: '+e.message,1);
 const live=mt.data.filter(m=>m.status==='live').map(m=>m.id);
 const ds=live.length?(await sb.from('deliveries').select('*').in('match_id',live).order('seq')).data||[]:[];
 const cids=mt.data.filter(m=>m.status==='completed').map(m=>m.id);
 const cd=cids.length?await pageAll(()=>sb.from('deliveries').select('*').in('match_id',cids).order('id')):[];
 const rr=await fetchRR();
 const pr=isMgr()?(await sb.from('profiles').select('*')).data||[]:[];
 const linkReqs=user?(await sb.from('player_link_requests').select('*').order('created_at',{ascending:false})).data||[]:[];
 D={league:l.data,players:p.data,teams:t.data,tp:tp.data,matches:mt.data,mp:mp.data,ds,cd,profiles:pr,rr,linkReqs};D.stats=calc()}
async function pageAll(q){let out=[],f=0;for(;;){const {data,error}=await q().range(f,f+999);if(error){toast('Could not load history: '+error.message,1);return out}out=out.concat(data);if(data.length<1000)return out;f+=1000}}
async function loadRole(){const {data}=await sb.auth.getSession();user=data.session?.user||null;role='viewer';
 if(user){const r=await sb.from('profiles').select('role').eq('id',user.id).maybeSingle();role=r.data?.role||'viewer'}}

/* ---------- views ---------- */
function welcome(){const a=isAdmin();
 return `<div class="hero"><h1>Welcome to Friend XI.</h1><p>BUILD YOUR LEAGUE. REGISTER YOUR CREW. START PLAYING.</p></div>
 <div class="card"><ol class="steps" style="padding-left:18px"><li>Create the league</li><li>Register players</li><li>Create teams</li><li>Schedule matches</li><li>Assign scorers</li></ol><small>You can skip any step and finish it later.</small></div>
 ${a?`<form class="card" onsubmit="makeLeague(event)"><label>League name<input name="n" required maxlength="60" placeholder="e.g. Sunday Crew League"></label><button class="b" style="width:100%">Create league</button></form>`
 :`<div class="empty"><h3>League not set up yet</h3><small>${user?'Only the owner can create the league.':'The league owner has not set it up yet.'}</small>${user?'':'<a class="b" style="display:inline-block;margin-top:14px" href="#/profile">Sign in or create account</a>'}</div>`}`}
async function makeLeague(e){e.preventDefault();const {error}=await sb.from('league').insert({id:1,name:new FormData(e.target).get('n')});if(error)return toast(error.message,1);await load();route()}
function vHome(){if(!D.league)return welcome();
 const st=[['Register players',D.players.length,'#/players'],['Create teams',D.teams.length,'#/teams']];
 return `<div class="hero"><h1>${esc(D.league.name)}</h1><p>PLAY TO WIN. PLAY FOR THE CREW.</p></div>
 ${liveCard()}${latest()}
 <div class="card stats"><div><b>${D.players.length}</b><small>Players</small></div><div><b>${D.teams.length}</b><small>Teams</small></div><div><b>${D.matches.length}</b><small>Matches</small></div></div>
 ${isMgr()?`<div class="card"><h3>Setup</h3><ul class="steps"><li>Create the league<span class="ok">Done</span></li>${st.map(s=>`<li>${s[0]}${s[1]?`<span class="ok">${s[1]} added</span>`:`<a class="b2" href="${s[2]}">Start</a>`}</li>`).join('')}<li>Schedule matches${D.matches.length?`<span class="ok">${D.matches.length} created</span>`:'<a class="b2" href="#/matches">Start</a>'}</li><li>Assign scorers<a class="b2" href="#/profile">People</a></li></ul></div>`:''}`}
function vPlayers(id){if(id)return vPlayer(id);const a=isMgr();
