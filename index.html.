/* ENGINE START — every number below is derived from recorded deliveries */
const tn=id=>D.teams.find(t=>t.id===id)?.name||'Deleted team';
const pn=id=>{const p=D.players.find(x=>x.id===id);return p?(p.nickname||p.full_name):'—'};
const ovs=b=>`${Math.floor(b/6)}.${b%6}`;
const isLegal=d=>d.extra_type!=='wide'&&d.extra_type!=='noball';
const canScore=m=>isMgr()||(!!user&&m.scorer_id===user.id);
function lbl(d){return d.wicket?'W':d.extra_type==='wide'?'Wd'+(d.extra_runs>1?'+'+(d.extra_runs-1):''):d.extra_type==='noball'?'Nb'+(d.runs_bat?'+'+d.runs_bat:''):d.extra_type==='bye'?'B'+d.extra_runs:d.extra_type==='legbye'?'Lb'+d.extra_runs:String(d.runs_bat)}
function say(d){const e=d.extra_runs,r=d.runs_bat;if(d.wicket)return `OUT! ${pn(d.out_player_id)} ${d.wicket_type}`;if(d.extra_type==='wide')return 'Wide'+(e>1?`, ${e-1} run${e>2?'s':''} taken`:'');if(d.extra_type==='noball')return 'No ball'+(r?`, ${r} off the bat`:'');if(d.extra_type==='bye'||d.extra_type==='legbye')return `${e} ${d.extra_type==='bye'?'bye':'leg bye'}${e===1?'':'s'}`;return r===4?'FOUR':r===6?'SIX':r?`${r} run${r>1?'s':''}`:'no run'}
function inn(ds){const o={runs:0,wk:0,balls:0,ex:0,bat:{},bowl:{},order:[],log:[],part:{r:0,b:0}};
 const B=id=>o.bat[id]||(o.order.push(id),o.bat[id]={r:0,b:0,f:0,s:0,out:null}),W=id=>o.bowl[id]||(o.bowl[id]={b:0,r:0,w:0});
 for(const d of ds){const lg=isLegal(d),bt=B(d.batter_id);B(d.non_striker_id);const bw=W(d.bowler_id),tot=d.runs_bat+d.extra_runs;
  o.log.push({t:`${Math.floor(o.balls/6)}.${o.balls%6+1}`,l:lbl(d),s:`${pn(d.bowler_id)} to ${pn(d.batter_id)}, ${say(d)}`,w:d.wicket,r:d.runs_bat});
  o.runs+=tot;if(d.extra_type)o.ex+=d.extra_runs;if(lg)o.balls++;
  bt.r+=d.runs_bat;if(d.extra_type!=='wide')bt.b++;if(d.runs_bat===4)bt.f++;if(d.runs_bat===6)bt.s++;
  bw.r+=d.runs_bat+(d.extra_type==='wide'||d.extra_type==='noball'?d.extra_runs:0);if(lg)bw.b++;
  if(d.wicket){o.wk++;B(d.out_player_id).out={t:d.wicket_type,b:d.bowler_id};if(d.wicket_type!=='run out')bw.w++;o.part={r:0,b:0}}else{o.part.r+=tot;if(lg)o.part.b++}}
 return o}
function nxt(ds){const d=ds[ds.length-1];if(!d)return{s:null,n:null,bw:null,nb:false};
 let s=d.batter_id,n=d.non_striker_id;const rot=d.runs_bat+(d.extra_type==='bye'||d.extra_type==='legbye'?d.extra_runs:0)+(d.extra_type==='wide'?d.extra_runs-1:0);
 if(rot%2)[s,n]=[n,s];
 if(d.wicket){if(s===d.out_player_id)s=null;else if(n===d.out_player_id)n=null}
 let nb=false;if(isLegal(d)&&ds.filter(isLegal).length%6===0){nb=true;[s,n]=[n,s]}
 return{s,n,bw:d.bowler_id,nb}}
function sts(m,ds,mp){const first=!m.toss_winner||(m.toss_decision==='bat'?m.toss_winner===m.team_a:m.toss_winner!==m.team_a);
 const bt1=first?m.team_a:m.team_b,bt2=first?m.team_b:m.team_a,cnt=t=>Math.max(mp.filter(x=>x.team_id===t).length-1,1);
 const a=inn(ds.filter(d=>d.innings===1)),b=inn(ds.filter(d=>d.innings===2)),cap=m.overs*6;
 const done1=a.balls>=cap||a.wk>=cnt(bt1),tgt=a.runs+1,done2=done1&&(b.balls>=cap||b.wk>=cnt(bt2)||b.runs>=tgt);
 let res=null;if(done2){const w=cnt(bt2)-b.wk,r=a.runs-b.runs;res=b.runs>=tgt?`${tn(bt2)} won by ${w} wicket${w===1?'':'s'}`:b.runs===a.runs?'Match tied':`${tn(bt1)} won by ${r} run${r===1?'':'s'}`}
 return{bt1,bt2,a,b,done1,done2,tgt,res}}
/* ENGINE END */
