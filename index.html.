const CONFIG={SUPABASE_URL:"https://pwrioescxjhzykuojdwi.supabase.co",SUPABASE_ANON_KEY:"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB3cmlvZXNjeGpoenlrdW9qZHdpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUzNTczOTIsImV4cCI6MjExMDkzMzM5Mn0.4xdeHyClCljorwPjYFwyp72CaQFCBE08HnG-E2LpSrw"};
